cabal-version: 2.4
name: client
version: 0.1.0.0
build-type: Simple

executable client
  hs-source-dirs: src
  main-is: Main.hs
  other-modules:
    Network
    Render
    Input
    Assets
    Theme
    Components.UI
    Views.MainMenu
    Views.CharSelect
    Views.Lobby
    Views.MapSelect
    Views.HUD
    Views.Shop
    Views.Upgrade
    Views.Overlays
  build-depends:
    base,
    shared,
    websockets,
    aeson,
    gloss,
    directory
  default-language: Haskell2010