cabal-version: 2.4
name: client
version: 0.1.0.0
build-type: Simple

executable client
  hs-source-dirs: src
  main-is: Main.hs
  other-modules:
    Network
    Render
    Input
    Assets
  build-depends:    
    base >= 4.17 && < 5, 
    shared,
    websockets,
    aeson,
    gloss,
    directory,
    filepath
  default-language: Haskell2010