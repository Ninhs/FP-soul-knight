cabal-version: 2.4
name: server
version: 0.1.0.0
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
    Network
    Room
  build-depends:
    base,
    shared,
    websockets,
    stm,
    random,
    containers,
    aeson
  default-language: Haskell2010
  
executable server
    hs-source-dirs:   src
    main-is:          Main.hs
    other-modules:
        Config
        DB
        Network
        Room
    build-depends:
        base,
        shared,
        websockets,
        stm,
        random,
        containers,
        aeson,
        postgresql-simple,
        bytestring
    default-language: Haskell2010